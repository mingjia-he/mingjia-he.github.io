@article{He2026TCNS,
   bibtex_show={true},
   abbr={Preprint},
   topic={hierarchical},
   labels={Stackelberg games, Feedback optimization, Multimodal networks},
   author = {He, M. and He, Z. and Ghadamian, J. and Dörfler, F. and Frazzoli, E. and Zardini, G.},
   title = {Hierarchical Interactions in Mobility Networks: A Model-Free Feedback Approach},
   journal = {arXiv preprint arXiv:2611.18313},
   note = {Under review at IEEE Transactions on Control of Network Systems},
   year = {2026},
   arxiv = {2611.18313},
   abstract = {Urban mobility systems are large-scale networked systems whose performance emerges from hierarchically coupled decisions of public authorities, competing mobility operators, and travelers. Existing approaches to policy design either collapse one of these levels or assume that the authority can model and differentiate through the equilibrium responses of operators and travelers. In this paper, we model policy design as a tri-level game on a multimodal network, in which a municipality sets taxes, licenses, and integration subsidies, a public transport and a taxi operator compete on prices and service supply, and heterogeneous travelers reach a stochastic user equilibrium. We prove that the traveler equilibrium is unique and continuously differentiable in the operator strategies, that the variational inequality characterizing operator equilibria admits a solution for every policy, and that the resulting tri-level game admits a Stackelberg equilibrium. Building on this structure, we design a model-free hierarchical controller in which the municipality and the operators update their decisions from zeroth-order evaluations of observed equilibrium outcomes. On the Zurich multimodal network, operator equilibria computed from different initializations differ by a median of 0.3\% in the municipal objective. On a grid of 3,125 policies, only those that subsidize transfers between public transport and taxis benefit both operators, and 24 of them also lower travel costs without degrading the municipal objective. Finally, the controller matches the best policies of three black-box optimizers and terminates at the most consistent policies across runs.},
   preview = {tcns2026_optimization_trajectory.png},
}

@inproceedings{He2026ECC,
   bibtex_show={true},
   abbr={ECC},
   topic={hierarchical},
   labels={Stackelberg games, Feedback optimization, Policy design},
   author = {He, M. and He, Z. and Ghadamian, J. and Dörfler, F. and Frazzoli, E. and Zardini, G.},
   title = {Hierarchical Strategic Decision-Making in Layered Mobility Systems},
   booktitle = {European Control Conference (ECC)},
   year = {2026},
   arxiv = {2511.08734},
   abstract = {Mobility systems are complex socio-technical environments influenced by multiple stakeholders with hierarchically interdependent decisions, rendering effective control and policy design inherently challenging. We bridge hierarchical game-theoretic modeling with online feedback optimization by casting urban mobility as a tri-level Stackelberg game (travelers, operators, municipality) closed in a feedback loop. The municipality iteratively updates taxes, subsidies, and operational constraints using a projected two-point (gradient-free) scheme, while lower levels respond through equilibrium computations (Frank-Wolfe for traveler equilibrium; operator best responses). This model-free pipeline enforces constraints, accommodates heterogeneous users and modes, and scales to higher-dimensional policy vectors without differentiating through equilibrium maps. On a real multimodal network for Zurich, Switzerland, our method attains substantially better municipal objectives than Bayesian optimization and Genetic algorithms, and identifies integration incentives that increase multimodal usage while improving both operator objectives. The results show that feedback-based regulation can steer competition toward cooperative outcomes and deliver tangible welfare gains in complex, data-rich mobility ecosystems.},
   preview = {ecc2026_overview.png},
}

@inproceedings{Shilov2026IFAC,
   bibtex_show={true},
   abbr={IFAC},
   topic={welfarist},
   labels={Price of anarchy, Social choice, Traffic control},
   author = {Shilov, I. and He, M. and Nax, H. H. and Frazzoli, E. and Zardini, G. and Bolognani, S.},
   title = {Invariant Price of Anarchy: A Metric for Welfarist Traffic Control},
   booktitle = {23rd IFAC World Congress},
   year = {2026},
   arxiv = {2512.05843},
   preview = {ifac2026_invariant_poa.png},
   abstract = {The Price of Anarchy (PoA) is a standard metric for quantifying inefficiency in socio-technical systems, widely used to guide policies like traffic tolling. Conventional PoA analysis relies on exact numerical costs. However, in many settings, costs represent agents' preferences and may be defined only up to possibly arbitrary scaling and shifting, representing informational and modeling ambiguities. We observe that while such transformations preserve equilibrium and optimal outcomes, they change the PoA value. To resolve this issue, we rely on results from Social Choice Theory and define the Invariant PoA. By connecting admissible transformations to degrees of comparability of agents' costs, we derive the specific social welfare functions which ensure that efficiency evaluations do not depend on arbitrary rescalings or translations of individual costs. Case studies on a toy example and the Zurich network demonstrate that identical tolling strategies can lead to substantially different efficiency estimates depending on the assumed comparability. Our framework thus demonstrates that explicit axiomatic foundations are necessary in order to define efficiency metrics and to appropriately guide policy in large-scale infrastructure design robustly and effectively.},
}

